{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cube Studio",
  "version": "2.0.0",
  "identifier": "com.aarint.cubestudio",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Cube Studio",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Visible",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "MIT licensed",
    "category": "DeveloperTool",
    "shortDescription": "GUI for Redis, Memcached, Kafka, RabbitMQ, NATS and MQTT",
    "longDescription": "Cube Studio is a desktop client for browsing and operating on caching, messaging and streaming middleware: Redis, Memcached, Kafka, RabbitMQ, NATS and MQTT.",
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "deb": {
        "depends": []
      }
    }
  }
}
