{
  "name": "cube-studio",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "A desktop GUI for Redis, Memcached, Kafka, RabbitMQ, NATS and MQTT",
  "author": "aarint",
  "license": "MIT",
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "vite",
    "build": "tauri build",
    "build:web": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:rust": "cd src-tauri && cargo test --lib",
    "test:integration": "cd src-tauri && cargo test --features integration",
    "typecheck": "tsc --noEmit",
    "version:set": "node scripts/set-version.mjs",
    "version:check": "node scripts/set-version.mjs --check"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
